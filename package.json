{
  "name": "shiguang-agent",
  "version": "0.2.0",
  "description": "拾光 — a lightweight hybrid agent runtime with structured context, durable state, and pluggable tools.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "echo \"tests not implemented yet\"",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "agent",
    "typescript",
    "sqlite",
    "plugins",
    "memory"
  ],
  "author": "",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  }
}
